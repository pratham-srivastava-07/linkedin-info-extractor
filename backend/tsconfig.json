{
  "compilerOptions": {
    "target": "es2022", "module": "commonjs", "rootDir": "./src", "outDir": "./dist",
    "resolveJsonModule": true, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "strict": true, "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "scripts"]
}
