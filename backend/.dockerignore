# Never send credentials into the build context. `.env` is the operator's live
# cookie file; a COPY . . anywhere in the Dockerfile would bake it into a layer.
.env
.env.*
!.env.example

node_modules
dist

tests
scripts
vitest.config.ts
tsconfig.test.json

.git
.gitignore
*.md
Dockerfile
.dockerignore
npm-debug.log*
