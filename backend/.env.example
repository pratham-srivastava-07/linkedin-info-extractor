# --- our own API ---
# 4000, not 3000: `next dev` in ../frontend uses 3000.
PORT=4000
NODE_ENV=development
# Callers must send: Authorization: Bearer <API_KEY>
API_KEY="change-me"

# Browser origins allowed to call this API. Comma-separated, or "*" for any.
# e.g. CORS_ORIGINS="http://localhost:3000,https://app.example.com"
CORS_ORIGINS="*"

# --- database ---
DATABASE_URL="postgresql://user:password@localhost:5432/profilelens?schema=public"


LINKEDIN_LI_AT=""
LINKEDIN_JSESSIONID="ajax:0000000000000000000"


# --- tuning ---
# How long we trust a validated session before re-checking it upstream.
SESSION_TTL_SECONDS=3600
# How long a normalized profile stays cached. 0 disables caching entirely.
CACHE_TTL_SECONDS=3600
# Hard ceiling on a single upstream request.
UPSTREAM_TIMEOUT_MS=15000
